.in{position:relative;flex:none;margin:auto;width:100%;aspect-ratio:2244/932;cursor:crosshair}
.in img{width:100%;height:100%;display:block;user-select:none;-webkit-user-drag:none}
.pin{position:absolute;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;border:3px solid #fff;box-shadow:0 1px 5px #0007;display:grid;place-items:center;font-size:12px;color:#fff;padding:0}
.pin.wait{background:var(--blu)}.pin.elder{background:var(--red)}.pin.near{background:#e89b0c;animation:p 1s infinite}.pin.done{background:var(--grn)}
.pin.mine{outline:3px solid #fff;outline-offset:1px}
@keyframes p{50%{transform:scale(1.3)}}
.team{position:absolute;width:20px;height:20px;margin:-10px;border-radius:50%;background:#000;border:3px solid #ffd400;font-size:11px;display:grid;place-items:center}
.rad{position:absolute;width:66.7%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;border:2px dashed #e89b0c;background:#e89b0c22;pointer-events:none}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:12px;margin-top:10px}
.card h2{font-size:15px;margin:0 0 8px}
label{display:block;font-size:13px;color:var(--mut);margin:8px 0 3px}
input[type=text],select{width:100%;padding:10px;border-radius:10px;border:1px solid var(--bd);background:var(--bg)}
.chk{display:flex;gap:8px;align-items:center;color:var(--tx);font-size:15px}.chk input{width:20px;height:20px}
.row{display:flex;gap:8px;margin-top:10px}.row .btn{flex:1}
.li{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--bd)}.li:first-of-type{border:0}
.li div{flex:1;min-width:0}.li small{color:var(--mut);display:block}
.tag{font-size:11px;padding:2px 8px;border-radius:99px;color:#fff;white-space:nowrap}
.legend{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:var(--mut);margin-top:6px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px}
#toast{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));background:#e89b0c;color:#000;padding:14px;border-radius:12px;font-weight:600;display:none;z-index:9;box-shadow:0 4px 16px #0006}
.hint{font-size:13px;color:var(--mut);margin:6px 2px}
</style></head><body>
